# Copy to .env.local and fill in. Never commit real values.
# Local development defaults below point at the docker compose database (npm run db:up).

# --- Supabase -------------------------------------------------------------
# Project URL (Supabase dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key. Safe to expose to the browser; access is limited by database grants/RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, server-only (storage uploads and deletes). Either a new `sb_secret_...` key
# (preferred; Settings > API Keys) or a legacy service_role JWT. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Prisma) ----------------------------------------------------
# Runtime connection used by the app (lib/prisma.ts).
# Production: Supabase transaction pooler, port 6543, e.g.
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Never use the session pooler (5432) here: every open client holds a backend connection.
# `?pgbouncer=true` is not needed: @prisma/adapter-pg uses unnamed statements.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/demircucu_dev
# Optional: connections per server instance (default 3, see lib/db/pool-config.ts).
# DATABASE_POOL_MAX=3
# Connection used by the Prisma CLI (migrate, introspection). Must be a direct or session-mode
# (port 5432) connection; transaction poolers do not support migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:54329/demircucu_dev
# Shadow database for `prisma migrate dev` and the CI drift check. Local only; wiped by Prisma.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/demircucu_shadow
# Integration tests only. Must point at a local database; the test runner refuses remote hosts.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/demircucu_test

# --- App ------------------------------------------------------------------
# Public base URL for metadata, OpenGraph images and auth e-mail links (lib/env/app-url.ts).
# Set it for Production (custom domain) and locally. Do NOT set it for the Vercel Preview
# environment: previews derive their URL from VERCEL_BRANCH_URL / VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
